# put about 100 MB of pictures in the tree.
docs/ui/**/*.png
docs/ui/index.html
docs/ui/catalog.json

# Launch films. The landing page shows the bar, not a film.
docs/launch/*.mp4
docs/launch/*.webm
docs/launch/*.gif
# The README's Obsidian timer stays. It is a short clip, not a launch film.
!docs/launch/readme-obsidian.gif

{
  "manifest_version": 3,
  "name": "Morse",
  "version": "0.2.0",
  "description": "Change any website in your own words. Point at something, describe the change, and your model makes it while you watch.",
  "minimum_chrome_version": "135",
  "permissions": ["storage", "scripting", "userScripts", "tabs", "downloads"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["host.js", "runtime.js"], "run_at": "document_idle" }
  ],
  "sandbox": { "pages": ["practice.html"] },
  "action": { "default_popup": "popup.html", "default_title": "Morse" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "commands": {
    "toggle-morse": { "suggested_key": { "default": "Ctrl+Shift+Space", "mac": "Alt+Shift+Space" }, "description": "Change this page" }
  },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
}

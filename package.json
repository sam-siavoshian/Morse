{
  "name": "morse-cli",
  "version": "0.2.0",
  "description": "Change any app or website in your own words. Point at something, describe the change, and your model (Claude Code, Codex or an API key) makes it while you watch.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://sam-siavoshian.github.io/RRAA/site/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sam-siavoshian/RRAA.git"
  },
  "bugs": {
    "url": "https://github.com/sam-siavoshian/RRAA/issues"
  },
  "keywords": [
    "morse",
    "electron",
    "chrome-extension",
    "userscript",
    "claude-code",
    "codex",
    "mods"
  ],
  "bin": {
    "morse": "daemon/cli.js"
  },
  "files": [
    "daemon/",
    "core/",
    "runtime/",
    "design/tokens.css",
    "dist/extension/",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "setup": "node daemon/cli.js setup",
    "morse": "node daemon/cli.js",
    "doctor": "node daemon/cli.js doctor",
    "extension": "node daemon/cli.js extension",
    "check": "node scripts/check.js",
    "test": "node tests/helpers/disk.js && node --test --test-timeout=300000 tests/*.test.js",
    "test:ui": "node tests/helpers/disk.js && node scripts/build.js && node scripts/test-ui.js",
    "test:soak": "node tests/helpers/disk.js && node scripts/build.js && node --test --test-timeout=600000 tests/soak/*.test.js",
    "desktop": "node desktop-app/run.js",
    "desktop:build": "node desktop-app/build.js",
    "prepare": "node scripts/build.js",
    "package:extension": "node scripts/build.js && node scripts/package-extension.js",
    "store": "node scripts/store.js",
    "pages": "node scripts/build-pages.js",
    "demo:serve": "node demo/serve.js",
    "ui": "node scripts/build.js && node demo/ui-catalog.js && node demo/contrast.js",
    "screenshots": "node scripts/build.js && node demo/shoot-extension.js && node demo/shoot-desktop.js && node demo/shoot-control.js",
    "store:screenshots": "node scripts/build.js && node scripts/store-screenshots.js",
    "store:promo": "node scripts/store-promo.js",
    "store:smoke": "node scripts/store-smoke.js",
    "release": "node scripts/release.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}

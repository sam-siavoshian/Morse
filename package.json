{
  "name": "morse-cli",
  "version": "0.3.4",
  "description": "Hack your apps in your own words. Reverse engineer closed apps, remove unwanted features, and build your own. Save, edit and share your mods.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://getmorse.vercel.app/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sam-siavoshian/RRAA.git"
  },
  "bugs": {
    "url": "https://github.com/sam-siavoshian/RRAA/issues"
  },
  "keywords": [
    "morse",
    "electron",
    "chrome-extension",
    "userscript",
    "claude-code",
    "codex",
    "mods"
  ],
  "bin": {
    "morse": "daemon/cli.js"
  },
  "files": [
    "daemon/",
    "core/",
    "runtime/",
    "native-dbi/",
    "design/tokens.css",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "setup": "node daemon/cli.js setup",
    "morse": "node daemon/cli.js",
    "doctor": "node daemon/cli.js doctor",
    "check": "node scripts/check.js",
    "test": "node tests/helpers/disk.js && node --test --test-timeout=300000 tests/*.test.js",
    "test:ui": "node tests/helpers/disk.js && node scripts/build.js && node scripts/test-ui.js",
    "test:soak": "node tests/helpers/disk.js && node scripts/build.js && node --test --test-timeout=600000 tests/soak/*.test.js",
    "desktop": "node desktop-app/run.js",
    "desktop:build": "node desktop-app/build.js",
    "prepare": "node scripts/build.js",
    "pages": "node scripts/build-pages.js",
    "demo:serve": "node demo/serve.js",
    "ui": "node scripts/build.js && node demo/ui-catalog.js && node demo/contrast.js",
    "screenshots": "node scripts/build.js && node demo/shoot-desktop.js",
    "release": "node scripts/release.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}

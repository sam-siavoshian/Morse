{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run pages",
  "outputDirectory": "dist/pages",
  "redirects": [
    { "source": "/site", "destination": "/", "permanent": true },
    { "source": "/site/", "destination": "/", "permanent": true },
    { "source": "/site/index.html", "destination": "/", "permanent": true },
    { "source": "/site/gallery.html", "destination": "/gallery.html", "permanent": true },
    { "source": "/site/privacy.html", "destination": "/privacy.html", "permanent": true }
  ]
}
